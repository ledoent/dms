<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dms_list.Renderer">
        <div class="dms_treeview">
            <div class="container-fluid dms_document_container ">
                <div class="row o_dms_header btn-group">
                    <button
                        class="btn btn-secondary o_dms_add_directory fa fa-database o_hidden"
                        t-ref="dms_add_directory"
                        t-on-click="onDMSAddDirectoryRecord"
                    />
                    <div class="o_dms_extra_actions btn-group" t-ref="extra_actions" />
                </div>
                <div
                    t-attf-class="row dms_document_row #{env.isSmall ? 'dms_document_mobile' : 'dms_document_desktop'}"
                >
                    <div class="dms_document_col dms_document_col_tree">
                        <div class="dms_document_tree">
                            <div class="dms_content">
                                <div class="dms_tree" t-ref="jstree" />
                            </div>
                        </div>
                    </div>
                    <div
                        class="dms_document_col dms_document_col_preview"
                        t-ref="dropZone"
                    >
                        <div t-if="showDragZone" class="o_dropzone">
                            <i class="fa fa-cloud-upload fa-10x" />
                        </div>
                        <div class="dms_document_preview">
                            <t t-call="dms_list.DocumentTreeViewDirectoryPreview" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    <t t-name="dms_list.DocumentTreeViewDirectoryPreview">
        <t t-if="Object.entries(nodeSelectedState.data).length !== 0">
            <t t-if="nodeSelectedState.data.resModel === 'dms.file'">
                <FilePreviewPane
                    recordId="nodeSelectedState.data.data.id"
                    onClose="() => { this.nodeSelectedState.data = {}; }"
                />
            </t>
            <t t-else="">
                <div class="o_dms_dir_preview">
                    <div class="o_dms_dir_preview__header">
                        <div
                            class="o_kanban_dms_dir_chip"
                            t-att-data-bucket="nodeSelectedState.data.data.name ? (((nodeSelectedState.data.data.name.charCodeAt(0) || 0) + (nodeSelectedState.data.data.name.charCodeAt(1) || 0)) % 8) + 1 : 1"
                            t-esc="nodeSelectedState.data.data.name ? nodeSelectedState.data.data.name.slice(0, 2).toUpperCase() : '?'"
                        />
                        <div class="o_dms_dir_preview__title">
                            <h5 t-esc="nodeSelectedState.data.data.name" />
                        </div>
                    </div>
                    <div class="o_dms_dir_preview__stats">
                        <div class="o_dms_dir_preview__stat">
                            <div
                                class="o_dms_dir_preview__stat_value"
                                t-esc="nodeSelectedState.data.data.count_total_files or 0"
                            />
                            <div class="o_dms_dir_preview__stat_label">Files</div>
                        </div>
                        <div class="o_dms_dir_preview__stat">
                            <div
                                class="o_dms_dir_preview__stat_value"
                                t-esc="nodeSelectedState.data.data.count_total_directories or 0"
                            />
                            <div class="o_dms_dir_preview__stat_label">Folders</div>
                        </div>
                        <div class="o_dms_dir_preview__stat">
                            <div
                                class="o_dms_dir_preview__stat_value"
                                t-esc="nodeSelectedState.data.data.count_elements or 0"
                            />
                            <div class="o_dms_dir_preview__stat_label">Items</div>
                        </div>
                        <div class="o_dms_dir_preview__stat">
                            <div
                                class="o_dms_dir_preview__stat_value"
                                t-esc="nodeSelectedState.data.data.human_size or '—'"
                            />
                            <div class="o_dms_dir_preview__stat_label">Size</div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
</templates>
